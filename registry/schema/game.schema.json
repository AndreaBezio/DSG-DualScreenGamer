{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "igdb": {
      "description": "IGDB game id; resolved automatically from identifiers when omitted",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "platforms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "identifiers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sha1",
              "md5",
              "crc32",
              "title_id",
              "serial",
              "steam_appid",
              "gog_id",
              "android_pkg",
              "retroachievements",
              "screenscraper",
              "launchbox"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "description": "Platform id from catalog/platforms.yaml",
            "type": "string"
          },
          "region": {
            "description": "e.g. USA, EUR, JPN",
            "type": "string"
          },
          "label": {
            "description": "Free text, e.g. \"Rev 1\"",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "platforms"
  ],
  "additionalProperties": false
}
