# Copy to .env (never commit it) and fill in.

# --- Database ---
POSTGRES_USER=dsg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dsg

# --- Ports on this machine (bound to 127.0.0.1: put your reverse proxy in front) ---
WEB_PORT=3100
API_PORT=3101
# WEB_BIND=0.0.0.0
# API_BIND=0.0.0.0

# --- Public URLs, as seen by visitors and emulators ---
PUBLIC_SITE_URL=http://localhost:3100
PUBLIC_API_URL=http://localhost:3101
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=120

# Shared secret between the website and the API (generate with: openssl rand -hex 32)
INTERNAL_TOKEN=

# --- Sign-in (community submissions) ---
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Callback URL: <PUBLIC_SITE_URL>/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Discord: https://discord.com/developers/applications -> OAuth2
#   Redirect: <PUBLIC_SITE_URL>/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Who becomes admin on sign-in (comma separated)
ADMIN_GITHUB_LOGINS=AndreaBezio
ADMIN_DISCORD_IDS=
UPLOAD_MAX_MB=10
# Key for the daily, one-way install-dedupe hashes (openssl rand -hex 32). No IPs are stored.
INSTALL_SALT=

# Token for POST /admin/sync (used by the GitHub Action after a merge). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Worker ---
# Read-only GitHub token (fine-grained, public repos, no permissions): 5000 req/h instead of 60
GITHUB_TOKEN=
# IGDB = Twitch developer app: https://dev.twitch.tv/console/apps (Client ID + Secret)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SYNC_INTERVAL_MINUTES=30
# Optional: https://retroachievements.org/settings -> Web API key; links dumps to RetroAchievements ids
RA_API_KEY=
# Hash assets without a GitHub sha256 digest, up to this size in bytes (0 = off)
SYNC_HASH_MAX_BYTES=0
# Pull manifests from git before each sync instead of using the copy baked in the image
REGISTRY_GIT_URL=https://github.com/AndreaBezio/DSG-DualScreenGamer.git
REGISTRY_GIT_BRANCH=main
